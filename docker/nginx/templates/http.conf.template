server {
    listen 80;
    server_name ${SERVER_NAME};
    root /var/www/html/public;
    index index.php;

    charset utf-8;
    client_max_body_size 32m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        access_log off;
    }

    include /etc/nginx/snippets/app.conf;
}
