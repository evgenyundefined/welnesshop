# Значения, которые задаются в панели хостинга. Секреты сюда не коммитятся.

APP_KEY=
APP_URL=https://agelesscode.store

# Имена, которые обслуживает nginx и которые попадают в сертификат, через
# пробел. Пусто — сайт остаётся на http, certbot не запускается.
SERVER_NAME=agelesscode.store www.agelesscode.store

# Почта для писем Let's Encrypt об истечении сертификата.
CERTBOT_EMAIL=

# Любое непустое значение переключает на тестовый сервер Let's Encrypt:
# сертификат браузер не примет, зато лимиты не выжигаются на отладке.
CERTBOT_STAGING=

DB_DATABASE=wellness
DB_USERNAME=wellness
DB_PASSWORD=
DB_ROOT_PASSWORD=

SHOP_ADMIN_NAME=Администратор
SHOP_ADMIN_EMAIL=
SHOP_ADMIN_PASSWORD=

# false, только пока сайт открыт по http и домен ещё без сертификата.
SESSION_SECURE_COOKIE=true

# Порты хоста. 80 нужен даже при https: по нему Let's Encrypt проверяет домен.
HTTP_PORT=80
HTTPS_PORT=443

# Демо-каталог из PDF: true только для первого показа, в бою не нужен.
SEED_CATALOG=false

# Заполняется, если образы собираются и пушатся в реестр.
APP_IMAGE=registry.example.ru/wellness-shop-app:latest
NGINX_IMAGE=registry.example.ru/wellness-shop-nginx:latest

# СДЭК. Боевой контур — https://api.cdek.ru/v2, тестовый — https://api.edu.cdek.ru/v2
# с аккаунтом EMscd6r9JnFiQ3bLoyjJY6eM78JrJceI и паролем PjLZkKBHEiLK3YsjtNrt3TGNG0ahs3kG.
CDEK_BASE_URL=https://api.cdek.ru/v2
CDEK_ACCOUNT=
CDEK_PASSWORD=
# Код города отправления в справочнике СДЭК (Москва — 44).
CDEK_FROM_CITY_CODE=44
# Код ПВЗ, откуда отгружаете, если отправляете со склада СДЭК.
CDEK_SHIPMENT_POINT=
# Габариты коробки в сантиметрах и вес товара по умолчанию в граммах.
CDEK_PACKAGE_LENGTH=20
CDEK_PACKAGE_WIDTH=15
CDEK_PACKAGE_HEIGHT=10
SHOP_DEFAULT_PRODUCT_WEIGHT_GRAMS=300

# ЮKassa. Пока пусто — оплата выключена, заказы оформляются без неё.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
