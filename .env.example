APP_NAME="Wellness Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Defaults match docker-compose. Without Docker, set DB_CONNECTION=sqlite and
# create database/database.sqlite instead.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wellness
DB_USERNAME=wellness
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Host ports published by docker-compose.
APP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379

SHOP_CURRENCY=RUB
SHOP_PRODUCTS_PER_PAGE=12
SHOP_MAX_PRODUCTS_PER_PAGE=60
SHOP_ORDERS_PER_PAGE=10
SHOP_MAX_ORDERS_PER_PAGE=50
SHOP_MAX_ITEM_QUANTITY=99
SHOP_ORDER_NUMBER_PREFIX=WLN
SHOP_MAX_PRODUCT_IMAGES=10
SHOP_MAX_IMAGE_KILOBYTES=5120
SHOP_ADMIN_PER_PAGE=20
SHOP_MAX_ADMIN_PER_PAGE=100

# Seeded administrator for /admin — смените пароль перед публикацией.
SHOP_ADMIN_NAME="Администратор"
SHOP_ADMIN_EMAIL=admin@example.com
SHOP_ADMIN_PASSWORD=Password1
